{
  "name": "queuebuzz-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build && node scripts/generate-sitemap.js",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "preview": "vite preview",
    "serve:dist": "caddy start --config Caddyfile",
    "serve:stop": "caddy stop",
    "lighthouse": "npm run build && lhci autorun",
    "test:e2e": "node scripts/test-e2e.js",
    "test:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "sonar:audit": "./scripts/sonar-audit.sh",
    "dodo:listen": "dodo wh listen --forward-to http://localhost:4000/api/v1/billing/webhook --test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/vue-query": "^5.101.0",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/vue-3": "^3.26.1",
    "@unhead/ssr": "^3.1.4",
    "@unhead/vue": "^3.1.4",
    "@vee-validate/yup": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.17.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.10",
    "firebase": "^12.14.0",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "js-yaml": "^4.2.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.2.2",
    "vee-validate": "^4.15.1",
    "vite-svg-loader": "^5.1.1",
    "vue": "^3.5.38",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^5.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@sonar/scan": "^4.3.6",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.8.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.3.0",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "playwright": "^1.59.1",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "^3.8.3",
    "puppeteer": "^24.43.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-ssg": "^28.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3"
  },
  "overrides": {
    "axios": "^1.17.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
